{
	"name": "clone-tabnews-2",
	"version": "1.0.0",
	"description": "Exercício do Curso.Dev do Caro Filipe Deschamps",
	"main": "index.js",
	"scripts": {
		"dev": "npm run services:up && npm run wait-for-db && npm run migrate:up && next dev",
		"lint:prettier:check": "prettier --check .",
		"lint:prettier:fix": "prettier --write .",
		"lint:eslint:check": "eslint .",
		"test": "cross-env-shell npm run services:up && npx concurrently --n next,jest -s command-jest --hide next -k true 'npx next dev' 'npx jest --runInBand --verbose'",
		"test:watch": "jest --watchAll --runInBand",
		"services:up": "docker compose -f infra/compose.yaml up -d --force-recreate",
		"services:stop": "docker compose -f infra/compose.yaml stop",
		"services:down": "docker compose -f infra/compose.yaml down",
		"migrate:create": "node-pg-migrate -m infra/migrations create",
		"migrate:up": "node-pg-migrate -m infra/migrations --env-path .env.development up",
		"wait-for-db": "node ./infra/scripts/wait-for-db.js"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"async-retry": "^1.3.3",
		"concurrently": "^8.2.2",
		"dotenv": "^16.4.4",
		"dotenv-expand": "^11.0.6",
		"next": "^13.1.6",
		"node-pg-migrate": "^6.2.2",
		"pg": "^8.11.3",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@eslint/json": "^0.14.0",
		"cross-env": "^7.0.3",
		"eslint": "^9.39.2",
		"eslint-config-next": "^16.1.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^28.14.0",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^16.5.0",
		"jest": "^29.6.2",
		"prettier": "^3.4.2",
		"wait-on": "^8.0.0"
	},
	"imports": {
		"#infra*": "./infra*"
	}
}
